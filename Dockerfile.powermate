# =============================================================================
# Powermate Hermes Agent - Dockerfile
# 基于 ubuntu:22.04（阿里云镜像），无编译工具，仅 Python 运行时
# =============================================================================
FROM docker.m.daocloud.io/library/ubuntu:22.04

# 换 apt 为阿里云源
RUN sed -i 's|http://archive.ubuntu.com/ubuntu|http://mirrors.aliyun.com/ubuntu|g' /etc/apt/sources.list && \
    sed -i 's|http://security.ubuntu.com/ubuntu|http://mirrors.aliyun.com/ubuntu|g' /etc/apt/sources.list

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv curl git tini ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# 安装 uv（预编二进制，无需编译工具）
RUN pip3 install uv -i https://pypi.tuna.tsinghua.edu.cn/simple
RUN uv python install 3.12
RUN uv venv --python 3.12 /opt/venv

ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/opt/venv/bin:${PATH}"

WORKDIR /opt/hermes

ENV UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# 先拷贝清单文件，利用层缓存
COPY pyproject.toml uv.lock ./
RUN touch README.md

# 安装 Python 依赖（所有包都有 wheels，不需要编译工具）
RUN uv sync --frozen --no-install-project --extra all --extra messaging

# 拷贝源码并安装项目
COPY . .
RUN uv pip install --no-cache-dir --no-deps -e "."

# Runtime
ENV HERMES_HOME=/opt/data
ENV HERMES_WEB_DIST=/opt/hermes/hermes_cli/web_dist
WORKDIR /opt/hermes

VOLUME [ "/opt/data" ]
EXPOSE 8642

ENTRYPOINT ["/usr/bin/tini", "-g", "--"]
CMD ["sh", "-c", "mkdir -p ${HERMES_HOME}/{cron,sessions,logs,hooks,memories,skills,skins,plans,workspace,home} && exec hermes gateway run"]
